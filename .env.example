# Copy to .env (gitignored, never committed) in this same directory on the
# Unraid box and fill in real values. docker-compose.yml reads this file
# automatically for its ${VAR} substitutions — this is separate from Rails'
# own dotenv-rails loading, which only applies inside a `bin/rails` process;
# it's moot here since .dockerignore excludes .env from the built image and
# compose injects these as real container env vars instead.

RAILS_MASTER_KEY=
REEF_1000_DATABASE_PASSWORD=

APEX_FUSION_USERNAME=
APEX_FUSION_PASSWORD=
APEX_CONTROLLER_ID=
APEX_KALK_PUMP_OUTPUT_NAME=
